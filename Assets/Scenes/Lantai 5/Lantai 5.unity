  m_EditorClassIdentifier: Assembly-CSharp::CollectibleItem
  itemName: Grafik Penjualan
  itemDescription: "Cetakan grafik batang bulanan, cukup rapi untuk ukuran laporan
    internal. Tapi garis tren dari bulan Agustus mendadak melonjak vertikal lurus
    ke atas \u2014 tidak ada skala yang bisa menjelaskan angka itu. Di sudut kertas,
    seseorang menulis tangan kecil: \"jangan kerja lembur sendirian di lantai ini.\""
  itemSprite: {fileID: 21300000, guid: 6694bc72401a86b40bcae336b9de5822, type: 3}
  secretCode: C
  interactRange: 15
  destroyOnPickup: 0
